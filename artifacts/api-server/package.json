{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "start:worker": "node --enable-source-maps ./dist/worker-entry.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "test:api": "tsx src/run-validation.ts api",
    "test:access": "tsx src/run-validation.ts access",
    "test:policies": "tsx src/run-validation.ts policies",
    "test:rules": "tsx src/run-validation.ts rules",
    "test:worklists": "tsx src/run-validation.ts worklists",
    "test:documents": "tsx src/run-validation.ts documents",
    "test:ai": "tsx src/run-validation.ts ai",
    "test:workflows": "tsx src/run-validation.ts workflow-operations",
    "test:contact-ehr": "tsx src/run-validation.ts contact-ehr",
    "test:attachments": "tsx src/run-validation.ts attachments",
    "test:clinical": "tsx src/run-validation.ts clinical",
    "test:caregivers": "tsx src/run-validation.ts caregivers",
    "test:local": "tsx src/run-validation.ts",
    "demo:prepare": "tsx src/prepare-clinical-demo.ts",
    "demo:prepare-data": "tsx src/prepare-clinical-demo.ts --data-only",
    "db:bootstrap-dev": "NODE_ENV=development tsx src/bootstrap-development.ts",
    "db:install-guards": "tsx src/install-integrity.ts",
    "migrate:document-storage": "tsx src/migrate-document-storage.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "archiver": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "fastest-levenshtein": "^1.0.16",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "p-limit": "^7.3.3",
    "pdfkit": "^0.20.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "svg-to-pdfkit": "^0.1.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pdfkit": "^0.17.7",
    "@types/svg-to-pdfkit": "^0.1.5",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
